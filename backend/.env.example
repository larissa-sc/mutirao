# Copie para .env (o .env fica fora do Git).
# Banco de desenvolvimento: `docker compose up -d` na raiz do repositório.
DATABASE_URL=postgres://mutirao:devpassword@localhost:5433/mutirao
# true somente para bancos gerenciados que exigem SSL (ex.: Supabase)
DB_SSL=false
PORT=3000

# Estudo do N+1 (E2): imprime o SQL no terminal e liga as rotas /api/diagnostico
DB_LOGGING=false
DIAGNOSTICO=false
