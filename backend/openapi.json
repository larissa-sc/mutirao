            "type": "string"
          },
          "descricao": {
            "type": "string",
            "nullable": true
          },
          "dataDesejada": {
            "type": "string",
            "nullable": true
          },
          "localizacao": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizacaoResposta"
              }
            ]
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemPedidoResposta"
            }
          },
          "autor": {
            "$ref": "#/components/schemas/UsuarioResumo"
          },
          "status": {
            "type": "string",
            "enum": [
              "solicitado",
              "emAnalise",
              "aprovado",
              "encaminhado",
              "atendido",
              "negado",
              "cancelado"
            ]
          },
          "dataCriacao": {
            "format": "date-time",
            "type": "string"
          },
          "dataAtualizacao": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "categoria",
          "titulo",
          "descricao",
          "dataDesejada",
          "localizacao",
          "itens",
          "autor",
          "status",
          "dataCriacao",
          "dataAtualizacao"
        ]
      },
      "PaginaPedidos": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PedidoResposta"
            }
          }
        },
        "required": [
          "count",
          "page",
          "pageSize",
          "totalPages",
          "results"
        ]
      },
      "LocalizacaoDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "example": -8.123456,
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "example": -34.987654,
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "ItemDoPedidoDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "number",
            "example": 1,
            "description": "Id do item no catálogo"
          },
          "quantidade": {
            "type": "number",
            "example": 20
          },
          "unidade": {
            "type": "string",
            "example": "kg",
            "description": "Se omitida, usa a unidade padrão do item"
          }
        },
        "required": [
          "itemId",
          "quantidade"
        ]
      },
      "CriarPedidoDto": {
        "type": "object",
        "properties": {
          "autorId": {
            "type": "number",
            "description": "Temporário: até a autenticação (Etapa 3) o autor é informado aqui. Depois virá do token."
          },
          "categoriaId": {
            "type": "number",
            "example": 1
          },
          "titulo": {
            "type": "string",
            "example": "Sementes para o plantio de março"
          },
          "descricao": {
            "type": "string",
            "description": "Detalhes. Em pedido de declaração, a finalidade."
          },
          "dataDesejada": {
            "type": "string",
            "example": "2026-11-15",
            "description": "AAAA-MM-DD"
          },
          "localizacao": {
            "description": "Obrigatória em serviço de máquina; opcional em material",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizacaoDto"
              }
            ]
          },
          "itens": {
            "description": "Obrigatório em pedido de material",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDoPedidoDto"
            }
          }
        },
        "required": [
          "autorId",
          "categoriaId",
          "titulo"
        ]
      },
      "AtualizarPedidoDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Sementes para o plantio de março"
          },
          "descricao": {
            "type": "string",
            "description": "Detalhes. Em pedido de declaração, a finalidade."
          },
          "dataDesejada": {
            "type": "string",
            "example": "2026-11-15",
            "description": "AAAA-MM-DD"
          },
          "localizacao": {
            "description": "Obrigatória em serviço de máquina; opcional em material",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizacaoDto"
              }
            ]
          },
          "itens": {
            "description": "Obrigatório em pedido de material",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDoPedidoDto"
            }
          }
        }
      },
      "AlterarStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "solicitado",
              "emAnalise",
              "aprovado",
              "encaminhado",
              "atendido",
              "negado",
              "cancelado"
            ]
          },
          "observacao": {
            "type": "string",
            "description": "Obrigatória quando o status é \"negado\""
          },
          "responsavelId": {
            "type": "number",
            "description": "Temporário: até a autenticação (Etapa 3) quem altera é informado aqui. Depois virá do token."
          }
        },
        "required": [
          "status",
          "responsavelId"
        ]
      },
      "HistoricoResposta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "statusAnterior": {
            "type": "string",
            "enum": [
              "solicitado",
              "emAnalise",
              "aprovado",
              "encaminhado",
              "atendido",
              "negado",
              "cancelado"
            ],
            "nullable": true
          },
          "statusNovo": {
            "type": "string",
            "enum": [
              "solicitado",
              "emAnalise",
              "aprovado",
              "encaminhado",
              "atendido",
              "negado",
              "cancelado"
            ]
          },
          "observacao": {
            "type": "string",
            "nullable": true
          },
          "responsavel": {
            "$ref": "#/components/schemas/UsuarioResumo"
          },
          "data": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "statusAnterior",
          "statusNovo",
          "observacao",
          "responsavel",
          "data"
        ]
      }
    }
  }
}
